# Dependencies — reinstalled from pnpm-lock.yaml, never belongs in the repo
node_modules/

# Build output — regenerated by `pnpm build`, uploaded to Cloudflare by Wrangler
dist/

# Astro generated types and cache
.astro/

# Wrangler / Cloudflare local state and secrets
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Environment files
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
