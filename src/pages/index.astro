---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TopicLinks from '../components/TopicLinks.astro';

const title = 'شلال وادي نمار بالرياض | الموقع والمواعيد والدخول ودليل الزيارة';
const description = 'دليل زيارة شلال وادي نمار في الرياض: الموقع على الخريطة، معلومات الدخول، المواعيد، البحيرة، الممشى، المواقف ونصائح زيارة العائلات.';

const placeUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const mapsUrl = 'https://maps.app.goo.gl/sZTUMNDCSZH3b3VB6';
const reviewCount = '17,639';
const lastChecked = '4 نوفمبر 2026';
const plusCode = 'HMCH+QV Namar, Riyadh, Saudi Arabia';
const coordinates = {
  latitude: 24.5719945,
  longitude: 46.6797341
};

const attraction = {
  '@id': placeUrl ? placeUrl + '#attraction' : undefined,
  '@type': 'TouristAttraction',
  name: 'شلال وادي نمار',
  alternateName: 'Wadi Namar Waterfall',
  description,
  touristType: ['Families', 'Walkers', 'Sightseers'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '7010 علي بن أبي نصر، حي نمار',
    addressLocality: 'الرياض',
    postalCode: '14962',
    addressCountry: 'SA'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: coordinates.latitude,
    longitude: coordinates.longitude
  },
  ...(placeUrl ? { url: placeUrl } : {}),
  sameAs: [mapsUrl]
};

const faqs = [
  {
    "q": "هل دخول شلال وادي نمار مجاني؟",
    "a": "تشير صفحة السياحة السعودية إلى عدم وجود رسوم لشراء تذكرة دخول، أي أن الدخول إلى المنطقة العامة مجاني بحسب المعلومة المنشورة. لا يشمل ذلك بالضرورة أنشطة تجارية قد تفرض رسوماً، ولم نتحقق من رسوم المواقف."
  },
  {
    "q": "ما أوقات العمل؟ هل المكان مفتوح الآن؟",
    "a": "تشير بيانات خرائط Google التي راجعناها في 4 نوفمبر 2026 إلى أن المكان مدرج كمتاح على مدار الساعة. هذه لقطة من طرف ثالث وليست تأكيداً آنياً لفتح كل مدخل أو مرفق، ولا ضماناً لتشغيل الشلال. تحقق من التنبيهات المحلية قبل التحرك."
  },
  {
    "q": "ما الفرق بين الشلال والوادي والبحيرة؟",
    "a": "تشير نقطة الخريطة هنا إلى شلال وادي نمار. أما الوادي والبحيرة ومناطق التنزه فهي نطاق أوسع؛ لا تفترض أن حالة نقطة واحدة تصف جميع المداخل أو المرافق."
  },
  {
    "q": "هل يوجد ممشى حول البحيرة؟",
    "a": "تتضمن الأوصاف المنشورة للمشروع ممشى وكورنيشاً حول البحيرة، لكننا لم نتحقق من إتاحة كل جزء حالياً. راجع المسار المفتوح وإمكان الوصول عند الزيارة، ولا تعتبر الوصف ضماناً لسهولة الحركة."
  },
  {
    "q": "هل يمكن زيارة وادي نمار ليلاً؟",
    "a": "إذا اخترت المساء، تحقق أولاً من فتح المدخل والإضاءة ووسيلة العودة. لا يُثبت إدراج الخرائط على مدار الساعة سلامة كل مسار أو تشغيل المرافق ليلاً."
  },
  {
    "q": "كم أحتاج من الوقت؟",
    "a": "يمكن تخصيص ساعة إلى ساعتين كاقتراح مرن للمشي أو التصوير، ثم تعديل الخطة بحسب الطقس والمسارات المتاحة واحتياجات المجموعة. لا تُضمن رؤية تدفق الشلال."
  },
  {
    "q": "هل توجد مواقف وخدمات للعائلات؟",
    "a": "لم نتحقق من التوفر الحالي للمواقف أو مرافق الأطفال والخدمات. اسأل عن المكان المخصص للوقوف والمرافق المفتوحة، وراقب الأطفال قرب الماء والحواف الصخرية."
  },
  {
    "q": "هل يعمل الشلال دائماً؟",
    "a": "لم نجد جدول تشغيل رسمي حديثاً يمكن الاعتماد عليه. قد تختلف حالة التدفق والصيانة؛ تحقق من الجهة المعنية واللوحات المحلية ولا تبنِ الرحلة على صورة قديمة أو موعد تشغيل مفترض."
  }
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};

const webPage = {
  '@type': 'WebPage',
  '@id': placeUrl ? placeUrl + '#webpage' : undefined,
  url: placeUrl,
  name: title,
  description,
  inLanguage: 'ar-SA',
  isPartOf: { '@type': 'WebSite', name: 'شلال وادي نمار', url: placeUrl },
  about: { '@type': 'TouristAttraction', '@id': attraction['@id'] }
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [webPage, attraction, faqLd]
};
---
<BaseLayout {title} {description} {jsonLd}>
  <SiteHeader />

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-content">
        <div>
          <p class="eyebrow">الرياض · حي نمار · <span lang="en" dir="ltr">Wadi Namar Waterfall</span></p>
          <h1 id="hero-title">شلال وادي نمار<br /><span lang="en" dir="ltr">Wadi Namar Waterfall</span></h1>
          <p class="hero-sub">دليل زيارة الشلال والبحيرة في الرياض: الموقع، المواعيد، الدخول، الممشى، المواقف ونصائح العائلات. تحقق من الوصول والتدفق والمرافق في يوم الرحلة؛ هذا الدليل لا يقدم تحديثاً تشغيلياً مباشراً.</p>
          <div class="hero-actions">
            <a class="btn primary" href="#visit">خطّط زيارتك</a>
            <a class="btn" href={mapsUrl} target="_blank" rel="noopener noreferrer">افتح Google Maps</a>
            <a class="btn" href="#photos">صور الموقع</a>
          </div>
        </div>
        <aside class="hero-card glass" aria-label="ملخص سريع">
          <div class="rating"><strong>4.5</strong><span>★</span></div>
          <small>خرائط Google: {reviewCount} مراجعة · تمت المراجعة في {lastChecked} · تقييم طرف ثالث وليس مراجعات جمعها الموقع</small>
          <div class="hero-meta">
            <div class="meta-row"><span>التصنيف في الخرائط</span><b lang="en" dir="ltr">National Park</b></div>
            <div class="meta-row"><span>العنوان</span><b>7010 علي بن أبي نصر</b></div>
            <div class="meta-row"><span>أنسب زيارة</span><b>قرب الغروب والمساء</b></div>
          </div>
        </aside>
      </div>
    </section>

    <div class="fact-strip"><div class="container facts" aria-label="نطاق معلومات الزيارة"><div class="fact"><b>حي نمار</b><span>نقطة الشلال جنوب الرياض</span></div><div class="fact"><b dir="ltr">4.5 / 5</b><span>{reviewCount} مراجعة في خرائط Google</span></div><div class="fact"><b dir="ltr">{plusCode}</b><span>Plus Code للملاحة السريعة</span></div><div class="fact"><b>الوادي أوسع من الشلال</b><span>تحقق من كل مدخل وخدمة على حدة</span></div></div></div>

    <section class="section" id="management" aria-labelledby="management-title">
      <div class="container">
        <p class="eyebrow">الجهة المشرفة وإدارة الموقع</p>
        <h2 class="section-title" id="management-title">عن شلال وادي نمار</h2>
        <div class="article-card glass">
          <p>يقع شلال وادي نمار ضمن نطاق وادي نمار في جنوب الرياض، وتُدرج <a href="https://www.rcrc.gov.sa/projects/">الهيئة الملكية لمدينة الرياض</a> مشروعَي التأهيل البيئي لوادي نمار ومتنزه مطلات بحيرة نمار ضمن مشاريعها؛ فهي الجهة الرسمية المعلنة لتخطيط الموقع وتأهيله، وإلى بياناتها نعود في وصف المشروع. أما التشغيل اليومي للمداخل والمرافق وتدفق الشلال فلم نتحقق من جهة واحدة تتولاه، وقد تتعدد الجهات المعنية، وتبقى اللوحات والتنبيهات المحلية والقنوات الرسمية هي المرجع يوم الزيارة.</p>
          <p>نشأ الشلال كمنشأة مائية ضمن أعمال تأهيل الوادي، لا كشلال طبيعي يتدفق من منحدر جبلي على مدار العام؛ ومع البحيرة والممشى ومناطق التنزه أصبح المكان متنفساً مفتوحاً في جنوب العاصمة ومقصداً للمشي العائلي والتصوير قرب الغروب. وتفيد المصادر التعريفية بأن الدخول إلى المنطقة العامة لا يتطلب تذكرة، من دون أن يشمل ذلك بالضرورة الأنشطة التجارية أو رسوم المواقف التي لم نتحقق منها؛ تحقق من حالة الوصول والمرافق قبل التحرك.</p>
          <p class="updated-note">هذا دليل مستقل وغير ربحي للمعلومات السياحية والتثقيف العام، ولا يتبع الهيئة الملكية لمدينة الرياض أو أي جهة حكومية أو مشغّل للموقع. <a href="/waterfall/">عن الشلال</a> · <a href="/environmental-restoration/">خلفية مشروع التأهيل</a> · <a href="#sources">المصادر ونطاق التحقق</a></p>
        </div>
      </div>
    </section>

    <section class="section quick-info" id="quick-info">
      <div class="container">
        <p class="eyebrow">معلومات أساسية</p>
        <h2 class="section-title">العنوان، الخريطة، ونقطة الوصول</h2>
        <div class="quick-grid">
          <article class="quick-card glass">
            <h3>العنوان</h3>
            <p>7010 علي بن أبي نصر، حي نمار، الرياض 14962، المملكة العربية السعودية</p>
            <p><a href="/location/">تفاصيل الموقع والوصول →</a></p>
          </article>
          <article class="quick-card glass">
            <h3>Plus Code</h3>
            <p dir="ltr">{plusCode}</p>
            <p><a href="/location/">طريقة الوصول →</a></p>
          </article>
          <article class="quick-card glass">
            <h3>روابط سريعة</h3>
            <p><a href="/opening-hours/">المواعيد</a> · <a href="/entry-fee/">الدخول</a> · <a href="/waterfall/">الشلال</a> · <a href="/parking/">المواقف</a></p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="experience">
      <div class="container story-grid">
        <figure class="illustration"><img src="/images/water-illustration.svg" alt="رسم هندسي تجريدي للماء، ليس صورة للشلال أو تمثيلاً لحالته" width="1200" height="630" loading="lazy"/><figcaption>رسم أصلي لهذا الدليل، وليس صورة للموقع. <a href="/images/water-illustration.svg">المصدر SVG</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>؛ قد يُقص عند العرض المتجاوب.</figcaption></figure>
        <div>
          <p class="eyebrow">تجربة المكان</p>
          <h2 class="section-title">الوادي يتغيّر مع الضوء</h2>
          <p class="lead">تصف المواد التعريفية الوادي والبحيرة ومناطق التنزه، لكنها ليست تقريراً مباشراً عن التشغيل اليوم. حدد هدفك: مشاهدة نقطة الشلال أم المشي في الجزء المفتوح من المنطقة الأوسع.</p>
          <div class="story-points">
            <div class="story-point"><div class="num">01</div><div><h3>ابدأ من الشلال</h3><p>استخدم نقطة الخريطة المحددة للشلال، ثم تحقق من المسار المفتوح واللوحات قبل الاقتراب من الماء.</p></div></div>
            <div class="story-point"><div class="num">02</div><div><h3>امشِ بمحاذاة البحيرة</h3><p>اختر الجزء المتاح من المسار بحسب قدرتك واحتياجات مجموعتك؛ لم نتحقق من سهولة الوصول أو اكتمال الخدمات حالياً.</p></div></div>
            <div class="story-point"><div class="num">03</div><div><h3>اترك الغروب للنهاية</h3><p>إن خططت للتصوير قرب الغروب، تأكد من الطقس ووقت العودة والإضاءة في المسار الذي ستستخدمه.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="photos" aria-labelledby="photos-title">
      <div class="container">
        <p class="eyebrow">صور الموقع</p>
        <h2 class="section-title" id="photos-title">شلال وادي نمار بالصور</h2>
        <p class="lead">ثلاث لقطات للشلال والبحيرة والوادي عند الغروب، لتكوين فكرة عن المكان قبل التخطيط للزيارة.</p>
        <div class="photo-gallery">
          <figure class="photo-card glass">
            <img src="/images/wadi-namar-waterfall-hero.jpg" alt="تدفق الماء من جرف وادي نمار الصخري إلى الحوض أمامه، مع انعكاس الشلال على سطح الماء" width="1200" height="792" loading="lazy" decoding="async" />
            <figcaption><b>الشلال والجرف الصخري</b>لقطة قريبة لمسار الماء على الواجهة الصخرية وبركة الماء أمامها.</figcaption>
          </figure>
          <figure class="photo-card glass">
            <img src="/images/wadi-namar-lake-view.jpg" alt="بحيرة وادي نمار والممشى المرصوف بمحاذاتها مع نخلة وزوار، والشلال ظاهراً على الجرف المقابل" width="1413" height="825" loading="lazy" decoding="async" />
            <figcaption><b>البحيرة والممشى</b>المسار المحاذي للماء والجرف الذي يظهر فيه الشلال من الجهة المقابلة.</figcaption>
          </figure>
          <figure class="photo-card glass">
            <img src="/images/wadi-namar-evening.jpg" alt="غروب الشمس فوق وادي نمار، مع الشلال على الجرف الأيسر وامتداد البحيرة والممشى المضاء" width="1200" height="900" loading="lazy" decoding="async" />
            <figcaption><b>الوادي عند الغروب</b>منظر واسع يجمع الشلال والبحيرة وطرفي الممشى مع أضواء المساء.</figcaption>
          </figure>
        </div>
        <p class="updated-note">التقطت هذه الصور في أوقات سابقة؛ ظهور الماء فيها لا يثبت استمرار تدفق الشلال، ولا تؤكد الصور جاهزية الممشى أو المرافق يوم زيارتك. تحقق من الوضع قبل التحرك، وراجع <a href="#sources">المصادر ونطاق التحقق</a>.</p>
      </div>
    </section>

    <section class="section plan" id="visit">
      <div class="container">
        <p class="eyebrow">قبل أن تتحرك</p>
        <h2 class="section-title">خطة زيارة بلا مفاجآت</h2>
        <p class="lead">ابدأ بالتحقق من حالة الوصول في يومك المختار. إدراج الخرائط أو وصف مشروع قديم لا يضمن تشغيل الشلال أو جميع الخدمات، حتى لو كان المكان مدرجاً في الخرائط ضمن فئة National Park.</p>
        <div class="plan-grid">
          <article class="info-card glass"><div class="info-icon">⌂</div><h3>العنوان المؤكد</h3><p>العنوان الظاهر في الخرائط هو <strong>7010 علي بن أبي نصر، حي نمار، الرياض 14962</strong>. استخدمه مع Plus Code للوصول أدق. <a href="/location/">التفاصيل ←</a></p></article>
          <article class="info-card glass"><div class="info-icon">P</div><h3>مواقف السيارات</h3><p>اسأل عن المكان المخصص للوقوف وتوفره ورسومه يوم الزيارة. لا تُغلق المداخل أو الطريق، وحدد نقطة واضحة وآمنة للعودة. <a href="/parking/">المزيد ←</a></p></article>
          <article class="info-card glass"><div class="info-icon">☾</div><h3>أفضل وقت</h3><p>الأشهر الأبرد هي الأسهل للمشي. في الحر اختر <strong>ما قبل الغروب أو المساء</strong> وتجنب الشمس القوية منتصف النهار. <a href="/best-time-to-visit/">التفاصيل ←</a></p></article>
          <article class="info-card glass"><div class="info-icon">⌛</div><h3>مدة الزيارة</h3><p>للتصوير والمشي الخفيف خصص نحو <strong>ساعة إلى ساعتين</strong>. للنزهة العائلية والجلوس قرب الماء يمكنك البقاء أطول حسب الطقس.</p></article>
          <article class="info-card glass"><div class="info-icon">↝</div><h3>ساعات الوصول</h3><p>عرضت خرائط Google الوصول على مدار الساعة عند مراجعتنا في <strong>{lastChecked}</strong>؛ هذا وصف من طرف ثالث، لا تأكيد آني لفتح كل مدخل أو تشغيل المرافق أو تدفق الشلال. <a href="/opening-hours/">التفاصيل ←</a></p></article>
          <article class="info-card glass"><div class="info-icon">△</div><h3>السلامة والطقس</h3><p>ابتعد عن الحواف الصخرية ومجرى السيول وقت الأمطار، وراقب الأطفال قرب المياه. خذ ماءً كافياً في الأيام الحارة. <a href="/lake-safety/">سلامة البحيرة ←</a></p></article>
        </div>
        <div class="inline-links">
          <a href="/opening-hours/">مواعيد الزيارة</a>
          <a href="/entry-fee/">أسعار الدخول</a>
          <a href="/location/">الموقع والخريطة</a>
          <a href="/waterfall/">الشلال</a>
          <a href="/walking-trail/">الممشى</a>
          <a href="/parking/">المواقف</a>
        </div>
      </div>
    </section>

    <section class="section" id="transport">
      <div class="container">
        <p class="eyebrow">الوصول بالتفصيل</p>
        <h2 class="section-title">خطط للوصول ونقطة العودة</h2>
        <div class="route-grid">
          <div class="route-list">
            <div class="route-item"><div class="route-no">1</div><div><h3>من وسط الرياض</h3><p>اتجه جنوباً نحو حي نمار ثم استخدم الملاحة إلى «شلال وادي نمار». تجنب تثبيت مسار واحد في ذهنك لأن التحويلات المرورية قد تتغير. <a href="/from-central-riyadh/">التفاصيل ←</a></p></div></div>
            <div class="route-item"><div class="route-no">2</div><div><h3>تطبيقات النقل</h3><p>إذا اخترت سيارة أجرة أو تطبيق نقل، تحقق من توفر الخدمة وحدد نقطة النزول والعودة مع السائق؛ لا نفترض توفر مركبة في كل وقت. <a href="/by-taxi/">التفاصيل ←</a></p></div></div>
            <div class="route-item"><div class="route-no">3</div><div><h3>النقل العام</h3><p>راجع مخطط النقل العام الحالي من نقطة انطلاقك، وتحقق من الجزء الأخير إلى الشلال؛ لم نثبت مساراً مباشراً أو زمناً محدداً لهذه الرحلة. <a href="/public-transport/">التفاصيل ←</a></p></div></div>
            <div class="route-item"><div class="route-no">4</div><div><h3>العنوان للملاحة</h3><p>7010 علي بن أبي نصر، حي نمار، الرياض 14962. استخدم رابط الخريطة وPlus Code <span dir="ltr">{plusCode}</span> للتحقق من نقطة الوصول.</p></div></div>
          </div>
          <div class="route-note glass">
            <span class="pill">نصيحة نهاية الأسبوع</span>
            <h3>لا تجعل موقف السيارة آخر قرار في رحلتك</h3>
            <p>إذا كان هدفك الغروب، حاول الوصول قبل ذروة المساء بوقت كافٍ. المشي الإضافي القصير غالباً أفضل من الانتظار وسط ازدحام المداخل.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section plan" id="nearby">
      <div class="container">
        <p class="eyebrow">حول وادي نمار</p>
        <h2 class="section-title">أكمل المساء حول الوادي</h2>
        <p class="lead">أفكار عامة للتخطيط وليست فروعاً أو مسارات موثقة. تحقق من مكان كل وجهة وحالة الدخول إليها قبل إضافتها إلى الرحلة.</p>
        <div class="nearby-grid">
          <div class="nearby-group glass">
            <h3>اختيار الطعام</h3><div class="place-list"><div class="place"><div><b>تحقق من الفرع</b><small>راجع العنوان وساعات العمل قبل التوجه إلى أي مطعم؛ لا توجد توصية بفرع محدد هنا. <a href="/nearby-restaurants/">المزيد ←</a></small></div></div><div class="place"><div><b>الماء والاحتياجات</b><small>جهز ما تحتاجه للمشي بحسب الطقس بدلاً من افتراض وجود كشك مفتوح.</small></div></div><div class="place"><div><b>الميزانية والغذاء</b><small>اسأل عن القائمة والأسعار والاحتياجات الغذائية قبل الشراء.</small></div></div></div>
          </div>
          <div class="nearby-group glass">
            <h3>قبل إضافة وجهة أخرى</h3><div class="place-list"><div class="place"><div><b>البحيرة والوادي</b><small>نطاق أوسع من نقطة الشلال؛ تحقق من الجزء المتاح قبل تحديد مسار المشي. <a href="/lake/">التفاصيل ←</a></small></div></div><div class="place"><div><b>الإطلالات</b><small>لا تفترض فتح مطل أو أمان الوصول إليه اعتماداً على اسم متداول أو صورة قديمة. <a href="/viewpoint/">التفاصيل ←</a></small></div></div><div class="place"><div><b>الدراجات</b><small>تحقق من السماح بالنشاط والمسار المخصص إن وجد؛ لم نثبت مساراً حالياً للدراجات.</small></div></div></div>
          </div>
        </div>
      </div>
    </section>

    <TopicLinks />

    <section class="section" id="map">
      <div class="container">
        <p class="eyebrow">الموقع</p>
        <h2 class="section-title">الشلال على الخريطة</h2>
        <div class="map-wrap">
          <iframe title="خريطة شلال وادي نمار" src={`https://www.google.com/maps?q=${coordinates.latitude},${coordinates.longitude}&output=embed&hl=ar`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <div class="map-caption"><p>حي نمار، جنوب الرياض · استخدم نقطة الشلال نفسها عند طلب سيارة أو مشاركة الموقع. <a href={mapsUrl} target="_blank" rel="noopener noreferrer">فتح الخريطة الكاملة</a></p><code dir="ltr">{coordinates.latitude}, {coordinates.longitude}</code></div>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="container">
        <p class="eyebrow">أسئلة شائعة</p>
        <h2 class="section-title">قبل أن تسأل الخريطة</h2>
        <div class="faq">
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="section" id="sources"><div class="container"><h2 class="section-title">المصادر ونطاق التحقق</h2><p>راجعت بيانات نقطة الشلال في خرائط Google في {lastChecked}: تقييم 4.5 من {reviewCount} مراجعة، والتصنيف الظاهر National Park، والعنوان <span dir="ltr">7010 Ali bin Abi Nasr, Namar, Riyadh 14962</span> مع Plus Code <span dir="ltr">{plusCode}</span>. هذه بيانات طرف ثالث وليست مراجعات خاصة بالموقع أو تقرير فتح آني.</p><p>تسرد <a href="https://www.rcrc.gov.sa/projects/">الهيئة الملكية لمدينة الرياض</a> مشروعي التأهيل البيئي لوادي نمار ومتنزه مطلات بحيرة نمار. وجود وصف مشروع لا يثبت حالة تشغيل مرافقه اليوم. صفحة <a href="https://www.visitsaudi.com/ar/riyadh/attractions/wadi-namar">السياحة السعودية</a> مرجع تعريفي للمكان وتذكر عدم وجود رسوم دخول.</p><p><a href={mapsUrl}>نقطة شلال وادي نمار على الخريطة</a> · <a href="/images/water-illustration.svg">الرسم الأصلي</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>. الرسم تجريدي وليس صورة أو توثيقاً لحالة الشلال.</p></div></section>
