---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'شلال وادي نمار الرياض | الموقع والتحقق من الدخول ومواعيد الزيارة';
const description = 'دليل مستقل لشلال وادي نمار في الرياض: الموقع الدقيق، وكيفية التحقق من رسوم الدخول وحالة الوصول وتدفق الشلال قبل الزيارة. بيانات خرائط مؤرخة وليست ضماناً للتشغيل.';

const placeUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;

const attraction = {
  '@type': 'TouristAttraction',
  name: 'شلال وادي نمار',
  alternateName: 'Wadi Namar Waterfall',
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '7010 علي بن أبي نصر، حي نمار',
    addressLocality: 'الرياض',
    postalCode: '14962',
    addressCountry: 'SA'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 24.5719945,
    longitude: 46.6797341
  },
  ...(placeUrl ? { url: placeUrl } : {})
};

const faqs = [
  {
    "q": "هل دخول شلال وادي نمار مجاني؟",
    "a": "لم نتحقق من تعرفة رسمية حديثة للدخول أو المواقف. لا يعني ذلك ثبوت وجود رسوم؛ تحقق من اللوحات والجهة المعنية قبل الدفع، وافصل الدخول إلى المنطقة العامة عن المشتريات أو الأنشطة الخاصة."
  },
  {
    "q": "ما أوقات العمل؟ هل المكان مفتوح الآن؟",
    "a": "عرضت خرائط Google الوصول على مدار الساعة عند المراجعة في 29 أكتوبر 2026. هذه لقطة من طرف ثالث وليست تأكيداً آنياً لفتح كل مدخل أو مرفق، ولا ضماناً لتشغيل الشلال. تحقق من التنبيهات المحلية قبل التحرك."
  },
  {
    "q": "ما الفرق بين الشلال والوادي والبحيرة؟",
    "a": "تشير نقطة الخريطة هنا إلى شلال وادي نمار. أما الوادي والبحيرة ومناطق التنزه فهي نطاق أوسع؛ لا تفترض أن حالة نقطة واحدة تصف جميع المداخل أو المرافق."
  },
  {
    "q": "هل يوجد ممشى حول البحيرة؟",
    "a": "تتضمن الأوصاف المنشورة للمشروع ممشى وكورنيشاً حول البحيرة، لكننا لم نتحقق من إتاحة كل جزء حالياً. راجع المسار المفتوح وإمكان الوصول عند الزيارة، ولا تعتبر الوصف ضماناً لسهولة الحركة."
  },
  {
    "q": "هل يمكن زيارة وادي نمار ليلاً؟",
    "a": "إذا اخترت المساء، تحقق أولاً من فتح المدخل والإضاءة ووسيلة العودة. لا يُثبت إدراج الخرائط على مدار الساعة سلامة كل مسار أو تشغيل المرافق ليلاً."
  },
  {
    "q": "كم أحتاج من الوقت؟",
    "a": "يمكن تخصيص ساعة إلى ساعتين كاقتراح مرن للمشي أو التصوير، ثم تعديل الخطة بحسب الطقس والمسارات المتاحة واحتياجات المجموعة. لا تُضمن رؤية تدفق الشلال."
  },
  {
    "q": "هل توجد مواقف وخدمات للعائلات؟",
    "a": "لم نتحقق من التوفر الحالي للمواقف أو مرافق الأطفال والخدمات. اسأل عن المكان المخصص للوقوف والمرافق المفتوحة، وراقب الأطفال قرب الماء والحواف الصخرية."
  },
  {
    "q": "هل يعمل الشلال دائماً؟",
    "a": "لم نجد جدول تشغيل رسمي حديثاً يمكن الاعتماد عليه. قد تختلف حالة التدفق والصيانة؛ تحقق من الجهة المعنية واللوحات المحلية ولا تبنِ الرحلة على صورة قديمة أو موعد تشغيل مفترض."
  }
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [attraction, faqLd]
};
---
<BaseLayout {title} {description} {jsonLd}>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#top" aria-label="العودة إلى بداية الصفحة"><img src="/logo.svg" alt="شلال وادي نمار" /></a>
      <nav class="nav" aria-label="التنقل الرئيسي">
        <a href="#experience">التجربة</a>
        <a href="#visit">خطط للزيارة</a>
        <a href="#nearby">حول الوادي</a>
        <a href="#map" class="nav-cta">الخريطة</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-content">
        <div>
          <p class="eyebrow">الرياض · حي نمار</p>
          <h1 id="hero-title">شلال وادي نمار في الرياض</h1>
          <p class="hero-sub">خطط لزيارة نقطة الشلال في حي نمار مع التمييز بينها وبين الوادي والبحيرة. تحقق من الوصول والتدفق والمرافق في يوم الرحلة؛ هذا الدليل لا يقدم تحديثاً تشغيلياً مباشراً.</p>
          <div class="hero-actions">
            <a class="btn primary" href="#visit">خطّط زيارتك</a>
            <a class="btn" href="#map">افتح الخريطة داخل الصفحة</a>
          </div>
        </div>
        <aside class="hero-card glass" aria-label="ملخص سريع">
          <div class="rating"><strong>4.5</strong><span>★</span></div>
          <small>خرائط Google: 17,592 مراجعة · 29 أكتوبر 2026 · تقييم طرف ثالث وليس مراجعات جمعها الموقع</small>
          <div class="hero-meta">
            <div class="meta-row"><span>الدخول</span><b>تحقق من الرسوم</b></div>
            <div class="meta-row"><span>الطابع</span><b>بحيرة · شلال · ممشى</b></div>
            <div class="meta-row"><span>أنسب زيارة</span><b>قرب الغروب والمساء</b></div>
          </div>
        </aside>
      </div>
    </section>

    <div class="fact-strip"><div class="container facts" aria-label="نطاق معلومات الزيارة"><div class="fact"><b>حي نمار</b><span>نقطة الشلال جنوب الرياض</span></div><div class="fact"><b dir="ltr">4.5 / 5</b><span>تقييم Google Maps بتاريخ 29 أكتوبر 2026</span></div><div class="fact"><b>الوادي أوسع من الشلال</b><span>تحقق من كل مدخل وخدمة على حدة</span></div><div class="fact"><b>صورة توضيحية</b><span>لا تضمن حالة التدفق الحالية</span></div></div></div>

    <section class="section" id="experience">
      <div class="container story-grid">
        <figure class="illustration"><img src="/images/water-illustration.svg" alt="رسم هندسي تجريدي للماء، ليس صورة للشلال أو تمثيلاً لحالته" width="1200" height="630" loading="lazy"/><figcaption>رسم أصلي لهذا الدليل، وليس صورة للموقع. <a href="/images/water-illustration.svg">المصدر SVG</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>؛ قد يُقص عند العرض المتجاوب.</figcaption></figure>
        <div>
          <p class="eyebrow">تجربة المكان</p>
          <h2 class="section-title">الوادي يتغيّر مع الضوء</h2>
          <p class="lead">تصف المواد التعريفية الوادي والبحيرة ومناطق التنزه، لكنها ليست تقريراً مباشراً عن التشغيل اليوم. حدد هدفك: مشاهدة نقطة الشلال أم المشي في الجزء المفتوح من المنطقة الأوسع.</p>
          <div class="story-points">
            <div class="story-point"><div class="num">01</div><div><h3>ابدأ من الشلال</h3><p>استخدم نقطة الخريطة المحددة للشلال، ثم تحقق من المسار المفتوح واللوحات قبل الاقتراب من الماء.</p></div></div>
            <div class="story-point"><div class="num">02</div><div><h3>امشِ بمحاذاة البحيرة</h3><p>اختر الجزء المتاح من المسار بحسب قدرتك واحتياجات مجموعتك؛ لم نتحقق من سهولة الوصول أو اكتمال الخدمات حالياً.</p></div></div>
            <div class="story-point"><div class="num">03</div><div><h3>اترك الغروب للنهاية</h3><p>إن خططت للتصوير قرب الغروب، تأكد من الطقس ووقت العودة والإضاءة في المسار الذي ستستخدمه.</p></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section plan" id="visit">
      <div class="container">
        <p class="eyebrow">قبل أن تتحرك</p>
        <h2 class="section-title">خطة زيارة بلا مفاجآت</h2>
        <p class="lead">ابدأ بالتحقق من حالة الوصول في يومك المختار. إدراج الخرائط أو وصف مشروع قديم لا يضمن تشغيل الشلال أو جميع الخدمات.</p>
        <div class="plan-grid">
          <article class="info-card glass"><div class="info-icon">◌</div><h3>التذاكر والتكلفة</h3><p>لم نتحقق من تعرفة رسمية حديثة. تحقق من اللوحات والجهة المعنية قبل الدفع، وميّز أي نشاط أو شراء خاص عن الدخول إلى المنطقة العامة.</p></article>
          <article class="info-card glass"><div class="info-icon">P</div><h3>مواقف السيارات</h3><p>اسأل عن المكان المخصص للوقوف وتوفره ورسومه يوم الزيارة. لا تُغلق المداخل أو الطريق، وحدد نقطة واضحة وآمنة للعودة.</p></article>
          <article class="info-card glass"><div class="info-icon">☾</div><h3>أفضل وقت</h3><p>الأشهر الأبرد هي الأسهل للمشي. في الحر اختر <strong>ما قبل الغروب أو المساء</strong> وتجنب الشمس القوية منتصف النهار.</p></article>
          <article class="info-card glass"><div class="info-icon">⌛</div><h3>مدة الزيارة</h3><p>للتصوير والمشي الخفيف خصص نحو <strong>ساعة إلى ساعتين</strong>. للنزهة العائلية والجلوس قرب الماء يمكنك البقاء أطول حسب الطقس.</p></article>
          <article class="info-card glass"><div class="info-icon">↝</div><h3>ساعات الوصول</h3><p>عرضت خرائط Google الوصول على مدار الساعة بتاريخ 29 أكتوبر 2026؛ هذا وصف من طرف ثالث، لا تأكيد آني لفتح كل مدخل أو تشغيل المرافق أو تدفق الشلال.</p></article>
          <article class="info-card glass"><div class="info-icon">△</div><h3>السلامة والطقس</h3><p>ابتعد عن الحواف الصخرية ومجرى السيول وقت الأمطار، وراقب الأطفال قرب المياه. خذ ماءً كافياً في الأيام الحارة.</p></article>
        </div>
      </div>
    </section>

    <section class="section" id="transport">
      <div class="container">
        <p class="eyebrow">الوصول بالتفصيل</p>
        <h2 class="section-title">خطط للوصول ونقطة العودة</h2>
        <div class="route-grid">
          <div class="route-list">
            <div class="route-item"><div class="route-no">1</div><div><h3>من وسط الرياض</h3><p>اتجه جنوباً نحو حي نمار ثم استخدم الملاحة إلى «شلال وادي نمار». تجنب تثبيت مسار واحد في ذهنك لأن التحويلات المرورية قد تتغير.</p></div></div>
            <div class="route-item"><div class="route-no">2</div><div><h3>تطبيقات النقل</h3><p>إذا اخترت سيارة أجرة أو تطبيق نقل، تحقق من توفر الخدمة وحدد نقطة النزول والعودة مع السائق؛ لا نفترض توفر مركبة في كل وقت.</p></div></div>
            <div class="route-item"><div class="route-no">3</div><div><h3>النقل العام</h3><p>راجع مخطط النقل العام الحالي من نقطة انطلاقك، وتحقق من الجزء الأخير إلى الشلال؛ لم نثبت مساراً مباشراً أو زمناً محدداً لهذه الرحلة.</p></div></div>
            <div class="route-item"><div class="route-no">4</div><div><h3>العنوان للملاحة</h3><p>7010 علي بن أبي نصر، حي نمار، الرياض 14962. استخدم رابط الخريطة للتحقق من نقطة الوصول.</p></div></div>
          </div>
          <div class="route-note glass">
            <span class="pill">نصيحة نهاية الأسبوع</span>
            <h3>لا تجعل موقف السيارة آخر قرار في رحلتك</h3>
            <p>إذا كان هدفك الغروب، حاول الوصول قبل ذروة المساء بوقت كافٍ. المشي الإضافي القصير غالباً أفضل من الانتظار وسط ازدحام المداخل.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section plan" id="nearby">
      <div class="container">
        <p class="eyebrow">حول وادي نمار</p>
        <h2 class="section-title">أكمل المساء حول الوادي</h2>
        <p class="lead">أفكار عامة للتخطيط وليست فروعاً أو مسارات موثقة. تحقق من مكان كل وجهة وحالة الدخول إليها قبل إضافتها إلى الرحلة.</p>
        <div class="nearby-grid">
          <div class="nearby-group glass">
            <h3>اختيار الطعام</h3><div class="place-list"><div class="place"><div><b>تحقق من الفرع</b><small>راجع العنوان وساعات العمل قبل التوجه إلى أي مطعم؛ لا توجد توصية بفرع محدد هنا.</small></div></div><div class="place"><div><b>الماء والاحتياجات</b><small>جهز ما تحتاجه للمشي بحسب الطقس بدلاً من افتراض وجود كشك مفتوح.</small></div></div><div class="place"><div><b>الميزانية والغذاء</b><small>اسأل عن القائمة والأسعار والاحتياجات الغذائية قبل الشراء.</small></div></div></div>
          </div>
          <div class="nearby-group glass">
            <h3>قبل إضافة وجهة أخرى</h3><div class="place-list"><div class="place"><div><b>البحيرة والوادي</b><small>نطاق أوسع من نقطة الشلال؛ تحقق من الجزء المتاح قبل تحديد مسار المشي.</small></div></div><div class="place"><div><b>الإطلالات</b><small>لا تفترض فتح مطل أو أمان الوصول إليه اعتماداً على اسم متداول أو صورة قديمة.</small></div></div><div class="place"><div><b>الدراجات</b><small>تحقق من السماح بالنشاط والمسار المخصص إن وجد؛ لم نثبت مساراً حالياً للدراجات.</small></div></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="map">
      <div class="container">
        <p class="eyebrow">الموقع</p>
        <h2 class="section-title">الشلال على الخريطة</h2>
        <div class="map-wrap">
          <iframe title="خريطة شلال وادي نمار" src="https://www.google.com/maps?q=24.5719945,46.6797341&amp;output=embed&amp;hl=ar" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
          <div class="map-caption"><p>حي نمار، جنوب الرياض · استخدم نقطة الشلال نفسها عند طلب سيارة أو مشاركة الموقع.</p><code dir="ltr">24.5719945, 46.6797341</code></div>
        </div>
      </div>
    </section>

    <section class="section" id="faq">
      <div class="container">
        <p class="eyebrow">أسئلة شائعة</p>
        <h2 class="section-title">قبل أن تسأل الخريطة</h2>
        <div class="faq">
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="section" id="sources"><div class="container"><h2 class="section-title">المصادر ونطاق التحقق</h2><p>راجعت بيانات نقطة الشلال في خرائط Google في 29 أكتوبر 2026: تقييم 4.5 من 17,592 مراجعة، ووصول مدرج على مدار الساعة. هذه لقطة طرف ثالث وليست مراجعات خاصة بالموقع أو تقرير فتح آني.</p><p>تسرد <a href="https://www.rcrc.gov.sa/projects/">الهيئة الملكية لمدينة الرياض</a> مشروعي التأهيل البيئي لوادي نمار ومتنزه مطلات بحيرة نمار. وجود وصف مشروع لا يثبت حالة تشغيل مرافقه اليوم. صفحة <a href="https://www.visitsaudi.com/ar/riyadh/attractions/wadi-namar">السياحة السعودية</a> مرجع تعريفي، ولم نثبت من محتواها المتاح حالياً تعرفة دخول أو جدول تشغيل حديثاً.</p><p><a href="https://maps.app.goo.gl/sZTUMNDCSZH3b3VB6">نقطة شلال وادي نمار على الخريطة</a> · <a href="/images/water-illustration.svg">الرسم الأصلي</a> · <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>. الرسم تجريدي وليس صورة أو توثيقاً لحالة الشلال.</p></div></section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-top">
        <img class="footer-logo" src="/logo.svg" alt="شلال وادي نمار" />
        <div class="footer-links" aria-label="روابط الخصوصية">
          <button class="link-button" data-dialog-open="privacy-dialog">الخصوصية</button>
          <button class="link-button" data-dialog-open="terms-dialog">شروط الاستخدام</button>
          <button class="link-button" data-dialog-open="cookies-dialog">ملفات الارتباط</button>
          <button class="link-button" data-consent="settings">إعدادات التحليلات</button>
        </div>
      </div>
      <p id="consent-feedback" role="status"></p><p class="disclaimer">هذا دليل مستقل وغير ربحي للمعلومات السياحية والتثقيف العام، ولا يتبع أمانة منطقة الرياض أو الهيئة السعودية للسياحة أو أي جهة حكومية أو مشغل للموقع.</p>
    </div>
  </footer>

  <div class="consent glass" id="analytics-consent" role="dialog" aria-live="polite" aria-label="إذن التحليلات">
    <h2>تحليلات اختيارية</h2>
    <p>نستخدم Google Analytics 4 فقط إذا وافقت، ويمكنك تغيير اختيارك من أسفل الصفحة. يخص هذا الاختيار GA وحده ولا يتحكم بقياس أداء Cloudflare المستقل؛ التفاصيل في الخصوصية.</p>
    <p id="consent-status" role="status"></p><div class="consent-actions"><button class="accept" data-consent="accept">موافق</button><button data-consent="reject">رفض</button><button data-consent="close">إغلاق</button></div>
  </div>

  <dialog id="privacy-dialog">
    <div class="dialog-inner">
      <div class="dialog-head"><h2>الخصوصية</h2><button class="dialog-close" data-dialog-close aria-label="إغلاق">×</button></div>
      <p>لا يتطلب الموقع حساباً أو تسجيل دخول ولا يجمع بيانات شخصية عبر نماذج. يتم تفعيل Google Analytics 4 فقط بعد موافقتك. قد ترسل خرائط Google بيانات تقنية إلى مزودها عند تحميلها. الرسم التوضيحي يُحمّل من هذا الموقع.</p>
      <p>تستضيف Cloudflare هذا الموقع، وقد تضيف أداة مستقلة لقياس الأداء مثل <span dir="ltr">beacon.min.js</span> وترسل بيانات تقنية عن تحميل الصفحة وأزمنة الاتصال إلى Cloudflare. هذه الأداة ليست Google Analytics، ولا تتحكم بها أزرار الموافقة أو الرفض الخاصة بـ GA في هذه الصفحة؛ رفض GA لا يعني إيقاف قياس الأداء لدى مزود الاستضافة. راجع <a href="https://developers.cloudflare.com/web-analytics/data-metrics/data-origin-and-collection/" target="_blank" rel="noopener noreferrer">شرح Cloudflare لجمع بيانات الأداء</a>.</p>
    </div>
  </dialog>
  <dialog id="terms-dialog">
    <div class="dialog-inner">
      <div class="dialog-head"><h2>شروط الاستخدام</h2><button class="dialog-close" data-dialog-close aria-label="إغلاق">×</button></div>
      <p>المعلومات هنا للإرشاد العام وليست بياناً رسمياً. قد تتغير ساعات الوصول أو المرافق أو حالة الشلال أو الطرق. تحقّق من المصادر الرسمية والظروف المحلية قبل الزيارة، واتبع تعليمات السلامة في الموقع.</p>
    </div>
  </dialog>
  <dialog id="cookies-dialog">
