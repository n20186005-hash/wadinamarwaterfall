---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
  canonicalPath?: string;
  jsonLd: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, jsonLd, robots = 'index,follow,max-image-preview:large', canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = Astro.site ? new URL(canonicalPath, Astro.site) : undefined;
const ogImage = Astro.site ? new URL('/images/water-illustration.svg', Astro.site) : undefined;
---
<!doctype html>
<html lang="ar-SA" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#111817" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical.toString()} />}
    {canonical && <meta property="og:url" content={canonical.toString()} />}
    {ogImage && <meta property="og:image" content={ogImage.toString()} />}
    <meta property="og:image:alt" content="رسم ماء تجريدي أصلي؛ ليس صورة للشلال أو لحالته الحالية" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script is:inline src="/site.js" defer></script>
  </body>
</html>
